# PRIVATE CONFIGURATION TEMPLATE. Do not put an actual API key in this file.
OPENROUTER_API_KEY=
STUDENT_NAME=
STUDENT_ROLL_NO=

# Real OpenRouter disabled by default. Use Ollama in the website selector.
MOCK=1
ALLOW_LIVE_API=0
MAX_MOVES=20
TIME_LIMIT_S=300
REQUEST_TIMEOUT_S=60

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_CLEF=clef-flash
OLLAMA_MODEL_QWEN=qwen3.5:2b
OLLAMA_MODEL_LLAMA=llama3.2:3b
OLLAMA_MODEL_GEMMA=gemma3:1b
OLLAMA_REQUEST_TIMEOUT_S=300
OLLAMA_TIME_LIMIT_S=1200
OLLAMA_MAX_TOKENS=128
OLLAMA_DISABLE_THINKING=1
OLLAMA_STICKER_HINTS=0
OLLAMA_STOP_ON_REPEAT_LOOP=0

# Non-leading neutral prompt + reproducible order rotation (local only).
OLLAMA_PROMPT_VARIANT=neutral
OLLAMA_ROTATE_ACTIONS=1

# Hosted request budget and persistent cache are stored in data/usage.sqlite3.
# Never delete that file after using the teacher's restricted key.
